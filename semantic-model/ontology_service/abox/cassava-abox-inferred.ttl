cd:CBBSoilTemperature cd:isConditionOf abox:plant_1 .

cd:CGMSoilTemperature cd:isConditionOf abox:plant_3 .

cd:CBBRainySeason cd:isConditionOf abox:plant_1,
        abox:plant_4 .

cd:CBBSoilPH cd:isConditionOf abox:plant_1,
        abox:plant_4 .

cd:CBSDRelativeHumidity cd:isConditionOf abox:plant_1,
        abox:plant_2 .

cd:CGMSoilMoisture cd:isConditionOf abox:plant_1,
        abox:plant_3 .

cd:CMDSoilTemperature cd:isConditionOf abox:plant_1,
        abox:plant_4 .

abox:field_1 a owl:NamedIndividual,
        cd:Field ;
    cd:hasRainySeason true .

abox:field_2 a owl:NamedIndividual,
        cd:Field ;
    cd:hasRainySeason false .

abox:field_3 a owl:NamedIndividual,
        cd:Field ;
    cd:hasRainySeason false .

abox:field_4 a owl:NamedIndividual,
        cd:Field ;
    cd:hasRainySeason true .

abox:field_5 a owl:NamedIndividual,
        cd:Field ;
    cd:hasRainySeason false .

cd:CBSDSoilTemperature cd:isConditionOf abox:plant_1,
        abox:plant_2,
        abox:plant_4 .

cd:CMDHighRainfall cd:isConditionOf abox:plant_2,
        abox:plant_3,
        abox:plant_4 .

cd:CMDTemperature cd:isConditionOf abox:plant_3,
        abox:plant_4,
        abox:plant_5 .

abox:plant_5 a owl:NamedIndividual,
        cd:Plant ;
    cd:hasCondition cd:CBBSoilMoisture,
        cd:CBSDSoilMoisture,
        cd:CMDSoilMoisture,
        cd:CMDTemperature ;
    cd:isPlantedIn abox:soil_5 .

abox:soil_1 a owl:NamedIndividual,
        cd:Soil ;
    cd:isPartOfField abox:field_1 .

abox:soil_2 a owl:NamedIndividual,
        cd:Soil ;
    cd:isPartOfField abox:field_2 .

abox:soil_3 a owl:NamedIndividual,
        cd:Soil ;
    cd:isPartOfField abox:field_3 .

abox:soil_4 a owl:NamedIndividual,
        cd:Soil ;
    cd:isPartOfField abox:field_4 .

abox:soil_5 a owl:NamedIndividual,
        cd:Soil ;
    cd:isPartOfField abox:field_5 .

cd:CBBSoilMoisture cd:isConditionOf abox:plant_1,
        abox:plant_3,
        abox:plant_4,
        abox:plant_5 .

cd:CGMRelativeHumidity cd:isConditionOf abox:plant_1,
        abox:plant_2,
        abox:plant_3,
        abox:plant_4 .

cd:CMDSoilMoisture cd:isConditionOf abox:plant_1,
        abox:plant_3,
        abox:plant_4,
        abox:plant_5 .

abox:plant_2 a ext:HighRiskPlant,
        owl:NamedIndividual,
        cd:Plant ;
    ext:isFullyFavourableFor cd:CassavaBrownStreakDisease ;
    cd:hasCondition cd:CBSDRelativeHumidity,
        cd:CBSDSoilMoisture,
        cd:CBSDSoilTemperature,
        cd:CGMRelativeHumidity,
        cd:CMDHighRainfall ;
    cd:isPlantedIn abox:soil_2 .

cd:CBSDSoilMoisture cd:isConditionOf abox:plant_1,
        abox:plant_2,
        abox:plant_3,
        abox:plant_4,
        abox:plant_5 .

abox:plant_3 a ext:HighRiskPlant,
        owl:NamedIndividual,
        cd:Plant ;
    ext:isFullyFavourableFor cd:CassavaGreenMottle ;
    cd:hasCondition cd:CBBSoilMoisture,
        cd:CBSDSoilMoisture,
        cd:CGMRelativeHumidity,
        cd:CGMSoilMoisture,
        cd:CGMSoilTemperature,
        cd:CMDHighRainfall,
        cd:CMDSoilMoisture,
        cd:CMDTemperature ;
    cd:isPlantedIn abox:soil_3 .

abox:plant_4 a ext:HighRiskPlant,
        owl:NamedIndividual,
        cd:Plant ;
    ext:isFullyFavourableFor cd:CassavaMosaicDisease ;
    cd:hasCondition cd:CBBRainySeason,
        cd:CBBSoilMoisture,
        cd:CBBSoilPH,
        cd:CBSDSoilMoisture,
        cd:CBSDSoilTemperature,
        cd:CGMRelativeHumidity,
        cd:CMDHighRainfall,
        cd:CMDSoilMoisture,
        cd:CMDSoilTemperature,
        cd:CMDTemperature ;
    cd:isPlantedIn abox:soil_4 .

abox:plant_1 a ext:HighRiskPlant,
        owl:NamedIndividual,
        cd:Plant ;
    ext:isFullyFavourableFor cd:CassavaBacterialBlight,
        cd:CassavaBrownStreakDisease ;
    cd:hasCondition cd:CBBRainySeason,
        cd:CBBSoilMoisture,
        cd:CBBSoilPH,
        cd:CBBSoilTemperature,
        cd:CBSDRelativeHumidity,
        cd:CBSDSoilMoisture,
        cd:CBSDSoilTemperature,
        cd:CGMRelativeHumidity,
        cd:CGMSoilMoisture,
        cd:CMDSoilMoisture,
        cd:CMDSoilTemperature ;
    cd:isPlantedIn abox:soil_1 .

