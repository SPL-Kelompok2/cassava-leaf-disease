<swrl:Imp>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="https://www.sti-innsbruck.at/cassava-disease#Plant"/>
          <swrl:argument1 rdf:resource="urn:swrl#plant"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="https://www.sti-innsbruck.at/cassava-disease#isPlantedIn"/>
              <swrl:argument1 rdf:resource="urn:swrl#plant"/>
              <swrl:argument2 rdf:resource="urn:swrl#soil"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:IndividualPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="https://www.sti-innsbruck.at/cassava-disease#isPartOfField"/>
                  <swrl:argument1 rdf:resource="urn:swrl#soil"/>
                  <swrl:argument2 rdf:resource="urn:swrl#field"/>
                </swrl:IndividualPropertyAtom>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <swrl:IndividualPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="http://www.w3.org/ns/sosa/isFeatureOfInterestOf"/>
                      <swrl:argument1 rdf:resource="urn:swrl#field"/>
                      <swrl:argument2 rdf:resource="urn:swrl#obs"/>
                    </swrl:IndividualPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <rdf:Description>
                      <rdf:first>
                        <swrl:IndividualPropertyAtom>
                          <swrl:propertyPredicate rdf:resource="http://www.w3.org/ns/sosa/observedProperty"/>
                          <swrl:argument1 rdf:resource="urn:swrl#obs"/>
                          <swrl:argument2 rdf:resource="https://www.sti-innsbruck.at/cassava-disease#RelativeHumidity"/>
                        </swrl:IndividualPropertyAtom>
                      </rdf:first>
                      <rdf:rest>
                        <rdf:Description>
                          <rdf:first>
                            <swrl:DatavaluedPropertyAtom>
                              <swrl:propertyPredicate rdf:resource="http://www.w3.org/ns/sosa/hasSimpleResult"/>
                              <swrl:argument1 rdf:resource="urn:swrl#obs"/>
                              <swrl:argument2 rdf:resource="urn:swrl#result"/>
                            </swrl:DatavaluedPropertyAtom>
                          </rdf:first>
                          <rdf:rest>
                            <rdf:Description>
                              <rdf:first>
                                <swrl:BuiltinAtom>
                                  <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/>
                                  <swrl:arguments>
                                    <rdf:Description>
                                      <rdf:first rdf:resource="urn:swrl#result"/>
                                      <rdf:rest>
                                        <rdf:Description>
                                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.8</rdf:first>
                                        </rdf:Description>
                                      </rdf:rest>
                                    </rdf:Description>
                                  </swrl:arguments>
                                </swrl:BuiltinAtom>
                              </rdf:first>
                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                          </rdf:rest>
                        </rdf:Description>
                      </rdf:rest>
                    </rdf:Description>
                  </rdf:rest>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="https://www.sti-innsbruck.at/cassava-disease#hasCondition"/>
          <swrl:argument1 rdf:resource="urn:swrl#plant"/>
          <swrl:argument2 rdf:resource="https://www.sti-innsbruck.at/cassava-disease#CMDHighRainfall"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
</swrl:Imp>

<swrl:Imp>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="https://www.sti-innsbruck.at/cassava-disease#Plant"/>
          <swrl:argument1 rdf:resource="urn:swrl#plant"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="https://www.sti-innsbruck.at/cassava-disease#isPlantedIn"/>
              <swrl:argument1 rdf:resource="urn:swrl#plant"/>
              <swrl:argument2 rdf:resource="urn:swrl#soil"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:IndividualPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="http://www.w3.org/ns/sosa/isFeatureOfInterestOf"/>
                  <swrl:argument1 rdf:resource="urn:swrl#soil"/>
                  <swrl:argument2 rdf:resource="urn:swrl#obs"/>
                </swrl:IndividualPropertyAtom>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <swrl:IndividualPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="http://www.w3.org/ns/sosa/observedProperty"/>
                      <swrl:argument1 rdf:resource="urn:swrl#obs"/>
                      <swrl:argument2 rdf:resource="https://www.sti-innsbruck.at/cassava-disease#SoilTemperature"/>
                    </swrl:IndividualPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <rdf:Description>
                      <rdf:first>
                        <swrl:DatavaluedPropertyAtom>
                          <swrl:propertyPredicate rdf:resource="http://www.w3.org/ns/sosa/hasSimpleResult"/>
                          <swrl:argument1 rdf:resource="urn:swrl#obs"/>
                          <swrl:argument2 rdf:resource="urn:swrl#result"/>
                        </swrl:DatavaluedPropertyAtom>
                      </rdf:first>
                      <rdf:rest>
                        <rdf:Description>
                          <rdf:first>
                            <swrl:BuiltinAtom>
                              <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/>
                              <swrl:arguments>
                                <rdf:Description>
                                  <rdf:first rdf:resource="urn:swrl#result"/>
                                  <rdf:rest>
                                    <rdf:Description>
                                      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</rdf:first>
                                    </rdf:Description>
                                  </rdf:rest>
                                </rdf:Description>
                              </swrl:arguments>
                            </swrl:BuiltinAtom>
                          </rdf:first>
                          <rdf:rest>
                            <rdf:Description>
                              <rdf:first>
                                <swrl:BuiltinAtom>
                                  <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#lessThanOrEqual"/>
                                  <swrl:arguments>
                                    <rdf:Description>
                                      <rdf:first rdf:resource="urn:swrl#result"/>
                                      <rdf:rest>
                                        <rdf:Description>
                                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32</rdf:first>
                                        </rdf:Description>
                                      </rdf:rest>
                                    </rdf:Description>
                                  </swrl:arguments>
                                </swrl:BuiltinAtom>
                              </rdf:first>
                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                          </rdf:rest>
                        </rdf:Description>
                      </rdf:rest>
                    </rdf:Description>
                  </rdf:rest>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="https://www.sti-innsbruck.at/cassava-disease#hasCondition"/>
          <swrl:argument1 rdf:resource="urn:swrl#plant"/>
          <swrl:argument2 rdf:resource="https://www.sti-innsbruck.at/cassava-disease#CMDSoilTemperature"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
</swrl:Imp>

<swrl:Imp>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="https://www.sti-innsbruck.at/cassava-disease#Plant"/>
          <swrl:argument1 rdf:resource="urn:swrl#plant"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="https://www.sti-innsbruck.at/cassava-disease#isPlantedIn"/>
              <swrl:argument1 rdf:resource="urn:swrl#plant"/>
              <swrl:argument2 rdf:resource="urn:swrl#soil"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:IndividualPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="http://www.w3.org/ns/sosa/isFeatureOfInterestOf"/>
                  <swrl:argument1 rdf:resource="urn:swrl#soil"/>
                  <swrl:argument2 rdf:resource="urn:swrl#obs"/>
                </swrl:IndividualPropertyAtom>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <swrl:IndividualPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="http://www.w3.org/ns/sosa/observedProperty"/>
