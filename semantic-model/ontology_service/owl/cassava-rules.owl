<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://example.org/cassava-rules"
         xmlns="http://example.org/cassava-rules#"
         xmlns:swrl="http://www.w3.org/2003/11/swrl#">

<owl:Ontology rdf:about="http://example.org/cassava-rules">
  <owl:imports rdf:resource="https://www.sti-innsbruck.at/cassava-disease"/>
  <owl:imports rdf:resource="http://example.org/cassava-extension"/>
</owl:Ontology>

<swrl:Variable rdf:about="urn:swrl#plant"/>

<swrl:Variable rdf:about="urn:swrl#soil"/>

<swrl:Variable rdf:about="urn:swrl#field"/>

<swrl:Variable rdf:about="urn:swrl#rainy"/>

<swrl:Variable rdf:about="urn:swrl#obs"/>

<swrl:Variable rdf:about="urn:swrl#result"/>

<swrl:Imp>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="https://www.sti-innsbruck.at/cassava-disease#Plant"/>
          <swrl:argument1 rdf:resource="urn:swrl#plant"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="https://www.sti-innsbruck.at/cassava-disease#hasCondition"/>
              <swrl:argument1 rdf:resource="urn:swrl#plant"/>
              <swrl:argument2 rdf:resource="https://www.sti-innsbruck.at/cassava-disease#CMDTemperature"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:IndividualPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="https://www.sti-innsbruck.at/cassava-disease#hasCondition"/>
                  <swrl:argument1 rdf:resource="urn:swrl#plant"/>
                  <swrl:argument2 rdf:resource="https://www.sti-innsbruck.at/cassava-disease#CMDSoilMoisture"/>
                </swrl:IndividualPropertyAtom>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <swrl:IndividualPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="https://www.sti-innsbruck.at/cassava-disease#hasCondition"/>
                      <swrl:argument1 rdf:resource="urn:swrl#plant"/>
                      <swrl:argument2 rdf:resource="https://www.sti-innsbruck.at/cassava-disease#CMDSoilTemperature"/>
                    </swrl:IndividualPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <rdf:Description>
                      <rdf:first>
                        <swrl:IndividualPropertyAtom>
                          <swrl:propertyPredicate rdf:resource="https://www.sti-innsbruck.at/cassava-disease#hasCondition"/>
                          <swrl:argument1 rdf:resource="urn:swrl#plant"/>
                          <swrl:argument2 rdf:resource="https://www.sti-innsbruck.at/cassava-disease#CMDHighRainfall"/>
                        </swrl:IndividualPropertyAtom>
                      </rdf:first>
                      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </rdf:Description>
                  </rdf:rest>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="http://example.org/cassava-extension#isFullyFavourableFor"/>
          <swrl:argument1 rdf:resource="urn:swrl#plant"/>
          <swrl:argument2 rdf:resource="https://www.sti-innsbruck.at/cassava-disease#CassavaMosaicDisease"/>
